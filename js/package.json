{
  "name": "@pupiltree/latex",
  "version": "1.1.1",
  "description": "One contract, one corpus, one API for LaTeX math text: repair, normalize, canonicalize, segment, toPlain, audit.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "sideEffects": [
    "./dist/react.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "default": "./dist/dom.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "scripts"
  ],
  "scripts": {
    "gen-tables": "node scripts/gen-tables.mjs",
    "build": "tsc -p tsconfig.json && node scripts/build-iife.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test \"test/**/*.test.mjs\"",
    "prepare": "npm run build"
  },
  "dependencies": {},
  "peerDependencies": {
    "katex": ">=0.16.0",
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "katex": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/react": "^18.3.12",
    "esbuild": "^0.24.0",
    "jsdom": "^25.0.1",
    "katex": "^0.16.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
